# Firebase Web config for the Firebase Hosting build (npm run build:firebase).
# These are PUBLIC client identifiers, not secrets — but they're kept out of git
# so secret scanners stay quiet. Get them from the Firebase console:
#   Project settings > Your apps > SDK setup and configuration.
# Copy this file to client/.env.local and fill in the values.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
